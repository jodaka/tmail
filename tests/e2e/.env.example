# Optional overrides for run-tests.sh (copied to .env and edited).
# The E2E harness always points tmail at tests/e2e/tmail-e2e.toml (GreenMail);
# the defaults below need no file at all.

# Optional: require this text to appear on startup. The sidebar shows the
# mailbox names the server reports — GreenMail names its INBOX `Inbox`.
# TMAIL_EXPECT_TEXT=Inbox

# Binary to drive instead of the fresh cargo build, e.g. a release build:
# TMAIL_CMD=/absolute/path/to/target/release/tmail
