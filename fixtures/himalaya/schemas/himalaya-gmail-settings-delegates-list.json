{
  "$defs": {
    "GmailDelegate": {
      "description": "Delegate granted access to a Gmail account.",
      "properties": {
        "delegateEmail": {
          "default": "",
          "description": "Email address of the delegate.",
          "type": "string"
        },
        "verificationStatus": {
          "anyOf": [
            {
              "$ref": "#/$defs/GmailVerificationStatus"
            },
            {
              "type": "null"
            }
          ],
          "description": "Verification status of the delegate."
        }
      },
      "type": "object"
    },
    "GmailDelegatesListResponse": {
      "description": "Response wrapping the delegates of a Gmail account.",
      "properties": {
        "delegates": {
          "default": [],
          "description": "Delegates of the Gmail account.",
          "items": {
            "$ref": "#/$defs/GmailDelegate"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "GmailVerificationStatus": {
      "description": "Verification state of an email address owned by a Gmail account.",
      "oneOf": [
        {
          "const": "verificationStatusUnspecified",
          "description": "No verification status specified.",
          "type": "string"
        },
        {
          "const": "accepted",
          "description": "The address is verified and usable.",
          "type": "string"
        },
        {
          "const": "pending",
          "description": "The verification request is awaiting a response.",
          "type": "string"
        },
        {
          "const": "rejected",
          "description": "The verification request was rejected.",
          "type": "string"
        },
        {
          "const": "expired",
          "description": "The verification request expired without a response.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Renderable table of Gmail delegates.",
  "properties": {
    "response": {
      "$ref": "#/$defs/GmailDelegatesListResponse"
    }
  },
  "required": [
    "response"
  ],
  "title": "DelegatesTable",
  "type": "object"
}