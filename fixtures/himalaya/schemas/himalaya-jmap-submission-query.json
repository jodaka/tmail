{
  "$defs": {
    "JmapDelivered": {
      "description": "Delivery state of a single recipient (RFC 8621 §7.1.1).",
      "oneOf": [
        {
          "const": "queued",
          "description": "The message is in a local mail queue.",
          "type": "string"
        },
        {
          "const": "yes",
          "description": "The message was successfully delivered.",
          "type": "string"
        },
        {
          "const": "no",
          "description": "Delivery failed permanently.",
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "The delivery status is unknown.",
          "type": "string"
        }
      ]
    },
    "JmapDeliveryStatus": {
      "description": "Per-recipient delivery status from a submission.",
      "properties": {
        "delivered": {
          "$ref": "#/$defs/JmapDelivered",
          "description": "Delivery state for this recipient."
        },
        "displayed": {
          "$ref": "#/$defs/JmapDisplayed",
          "description": "Whether the message has been displayed to the recipient."
        },
        "smtpReply": {
          "description": "The SMTP reply for this recipient.",
          "type": "string"
        }
      },
      "required": [
        "smtpReply",
        "delivered",
        "displayed"
      ],
      "type": "object"
    },
    "JmapDisplayed": {
      "description": "Whether the email has been displayed to the recipient (RFC 8621 §7.1.1).",
      "oneOf": [
        {
          "const": "unknown",
          "description": "Display status is unknown.",
          "type": "string"
        },
        {
          "const": "yes",
          "description": "The message has been displayed.",
          "type": "string"
        },
        {
          "const": "no",
          "description": "The message has not been displayed.",
          "type": "string"
        }
      ]
    },
    "JmapEmailAddressWithParameters": {
      "description": "An email address with optional SMTP parameters.",
      "properties": {
        "email": {
          "description": "The email address.",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": "SMTP parameters (e.g. `NOTIFY`, `ORCPT`).",
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "email"
      ],
      "type": "object"
    },
    "JmapEmailSubmission": {
      "description": "A JMAP EmailSubmission object (RFC 8621 §7.1).\n\nRepresents a sending of an email from a particular identity.",
      "properties": {
        "deliveryStatus": {
          "additionalProperties": {
            "$ref": "#/$defs/JmapDeliveryStatus"
          },
          "description": "Per-recipient delivery status.",
          "type": [
            "object",
            "null"
          ]
        },
        "dsnBlobIds": {
          "description": "Blob IDs of DSN messages.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "emailId": {
          "description": "The ID of the email to send.",
          "type": [
            "string",
            "null"
          ]
        },
        "envelope": {
          "anyOf": [
            {
              "$ref": "#/$defs/JmapEnvelope"
            },
            {
              "type": "null"
            }
          ],
          "description": "SMTP envelope to use for delivery."
        },
        "id": {
          "description": "Server-assigned ID.",
          "type": [
            "string",
            "null"
          ]
        },
        "identityId": {
          "description": "The identity to send as.",
          "type": [
            "string",
            "null"
          ]
        },
        "mdnBlobIds": {
          "description": "Blob IDs of MDN messages.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "sendAt": {
          "description": "Date/time the submission was made (RFC 3339).",
          "type": [
            "string",
            "null"
          ]
        },
        "threadId": {
          "description": "The thread the email belongs to.",
          "type": [
            "string",
            "null"
          ]
        },
        "undoStatus": {
          "anyOf": [
            {
              "$ref": "#/$defs/JmapUndoStatus"
            },
            {
              "type": "null"
            }
          ],
          "description": "Current undo status: `\"pending\"`, `\"final\"`, or `\"canceled\"`."
        }
      },
      "type": "object"
    },
    "JmapEnvelope": {
      "description": "SMTP envelope for an email submission.",
      "properties": {
        "mailFrom": {
          "$ref": "#/$defs/JmapEmailAddressWithParameters",
          "description": "MAIL FROM address and parameters."
        },
        "rcptTo": {
          "description": "RCPT TO addresses and parameters.",
          "items": {
            "$ref": "#/$defs/JmapEmailAddressWithParameters"
          },
          "type": "array"
        }
      },
      "required": [
        "mailFrom",
        "rcptTo"
      ],
      "type": "object"
    },
    "JmapUndoStatus": {
      "description": "The undo status of an email submission (RFC 8621 §7.1).",
      "oneOf": [
        {
          "const": "pending",
          "description": "The submission may still be cancelled.",
          "type": "string"
        },
        {
          "const": "final",
          "description": "The submission can no longer be cancelled.",
          "type": "string"
        },
        {
          "const": "canceled",
          "description": "The submission was cancelled.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Renderable table of email submissions.",
  "properties": {
    "submissions": {
      "items": {
        "$ref": "#/$defs/JmapEmailSubmission"
      },
      "type": "array"
    }
  },
  "required": [
    "submissions"
  ],
  "title": "SubmissionsTable",
  "type": "object"
}